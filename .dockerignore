# Deny by default: even a remote Docker builder receives source code only.
**
!environment.docker.yml
!web_app/
!web_app/frontend/
!web_app/frontend/*.json
!web_app/frontend/vite.config.ts
!web_app/frontend/index.html
!web_app/frontend/src/
!web_app/frontend/src/**
!web_app/frontend/public/
!web_app/frontend/public/*.html
!web_app/backend/
!web_app/backend/*.py
!auto_2d_drawing/
!auto_2d_drawing/**/
!auto_2d_drawing/**/*.py
!auto_2d_drawing/templates/*_standard_preset.json
!tools/
!tools/*.py
!experimental_lab/
!experimental_lab/tolerance_extraction_audit/
!experimental_lab/tolerance_extraction_audit/common/
!experimental_lab/tolerance_extraction_audit/common/scripts/
!experimental_lab/tolerance_extraction_audit/common/scripts/*.py
!experimental_lab/tolerance_extraction_audit/DRAWING_CURRENT_FINAL/
!experimental_lab/tolerance_extraction_audit/DRAWING_CURRENT_FINAL/*.py
!experimental_lab/tolerance_extraction_audit/DRAWING_CURRENT_FINAL/ENGINE_MANIFEST.json
!docs/
!docs/generated/
!docs/generated/api_graph.json

# Final exclusions also protect against generated files inside source folders.
**/__pycache__/**
**/node_modules/**
**/data/**
**/output/**
**/outputs/**
**/models/**
**/experiments/**
**/benchmarks/**
**/reports/**
**/results/**
**/.env*
**/*.db
**/*.sqlite*
**/*.stp
**/*.step
**/*.stl
**/*.dxf
**/*.dwg
**/*.pdf
**/*.png
**/*.csv
**/*.xlsx
**/*.log
